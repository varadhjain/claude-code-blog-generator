<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Session Summary</title>
  {{{styles}}}
  <style>
    .blog-summary {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem;
    }
    .blog-header {
      border-bottom: 2px solid #0969da;
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }
    .blog-meta {
      display: flex;
      gap: 1.5rem;
      color: #586069;
      font-size: 0.9rem;
      margin-top: 0.5rem;
    }
    .blog-section {
      margin: 2.5rem 0;
    }
    .blog-section h2 {
      color: #0969da;
      margin-bottom: 1rem;
      font-size: 1.5rem;
    }
    .blog-section h3 {
      color: #1f2328;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      font-size: 1.25rem;
    }
    .prompt-list {
      margin: 1rem 0;
    }
    .prompt-item {
      margin: 0.75rem 0;
      padding: 0.75rem;
      background: #f6f8fa;
      border-radius: 6px;
      border-left: 3px solid #d0d7de;
    }
    .prompt-item.green {
      border-left-color: #1a7f37;
      background: #dafbe1;
    }
    .prompt-item.red {
      border-left-color: #cf222e;
      background: #ffebe9;
    }
    .prompt-item.yellow {
      border-left-color: #bf8700;
      background: #fff8c5;
    }
    .prompt-text {
      font-style: italic;
      color: #1f2328;
    }
    .prompt-annotation {
      font-size: 0.85rem;
      color: #586069;
      margin-top: 0.25rem;
    }
    .code-highlight {
      margin: 1rem 0;
    }
    .code-context {
      font-size: 0.875rem;
      color: #586069;
      margin-bottom: 0.25rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif;
    }
    pre {
      background: #f6f8fa;
      border: 1px solid #d0d7de;
      border-radius: 6px;
      padding: 1rem;
      overflow-x: auto;
      font-size: 0.875rem;
      margin: 0.5rem 0;
    }
    code {
      font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    }
    .outcome-box {
      background: #ddf4ff;
      border-left: 3px solid #0969da;
      padding: 1rem;
      border-radius: 6px;
      margin: 1rem 0;
    }
    .session-details {
      background: #f6f8fa;
      border-radius: 6px;
      padding: 1.5rem;
      margin: 2rem 0;
    }
    .session-details ul {
      list-style: none;
      padding: 0;
      margin: 0.5rem 0;
    }
    .session-details li {
      padding: 0.25rem 0;
    }
    .view-full-session {
      display: inline-block;
      background: #0969da;
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 500;
      margin: 2rem 0;
    }
    .view-full-session:hover {
      background: #0860ca;
    }
    .phase-divider {
      border-top: 1px solid #d0d7de;
      margin: 2.5rem 0;
    }
  </style>
</head>
<body>
  <div class="blog-summary">
    <div class="blog-header">
      <h1>{{title}}</h1>
      <div class="blog-meta">
        <span>⏱️ {{metadata.duration}}</span>
        <span>💬 {{metadata.messageCount}} messages</span>
        <span>📊 {{metadata.phaseCount}} phases</span>
      </div>
    </div>

    <div class="blog-section">
      <h2>🗺️ Session Flow</h2>
      <div class="mermaid">
{{{mermaidDiagram}}}
      </div>
    </div>

    <div class="blog-section">
      <h2>🎯 What We Built</h2>
      <p>{{goal.text}}</p>
    </div>

    <div class="blog-section">
      <h2>🚀 The Journey</h2>

      {{#each phases}}
        <h3>{{phaseName}}</h3>
        <p>{{description}}</p>

        {{#if ../promptsByPhase.[phaseId]}}
          <div class="prompt-list">
            <strong>Key prompts:</strong>
            {{#each ../promptsByPhase.[phaseId]}}
              <div class="prompt-item {{color}}">
                <div class="prompt-text">"{{truncate text 200}}"</div>
                <div class="prompt-annotation">{{annotation}} <a href="{{deepLink}}" style="color: #0969da; text-decoration: none;">→ see context</a></div>
              </div>
            {{/each}}
          </div>
        {{/if}}

        {{#if ../codeByPhase.[phaseId]}}
          <div class="code-highlights">
            <strong>Code highlights:</strong>
            {{#each (limit ../codeByPhase.[phaseId] 2)}}
              <div class="code-highlight">
                <div class="code-context">{{context}}</div>
                <pre><code class="language-{{language}}">{{code}}</code></pre>
              </div>
            {{/each}}
          </div>
        {{/if}}

        {{#unless @last}}
          <div class="phase-divider"></div>
        {{/unless}}
      {{/each}}
    </div>

    <div class="blog-section">
      <h2>✅ Outcome</h2>
      <div class="outcome-box">
        <p>{{outcome.text}}</p>
        {{#if outcome.lastPhase}}
          <p style="margin-top: 0.5rem; font-size: 0.9rem; color: #586069;">
            <strong>Final phase:</strong> {{outcome.lastPhase}}
          </p>
        {{/if}}
      </div>
    </div>

    <div class="session-details">
      <h3>Session Details</h3>
      <ul>
        <li><strong>Total messages:</strong> {{metadata.messageCount}}</li>
        <li><strong>User messages analyzed:</strong> {{metadata.userMessageCount}}</li>
        <li><strong>Duration:</strong> {{metadata.duration}}</li>
        {{#if metadata.startTime}}
          <li><strong>Started:</strong> {{formatDate metadata.startTime}}</li>
        {{/if}}
      </ul>
    </div>

    <div style="text-align: center;">
      <a href="index.html" class="view-full-session">
        View Full Annotated Session →
      </a>
    </div>

    <footer style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #d0d7de; text-align: center; color: #586069; font-size: 0.875rem;">
      <p>Generated with <a href="https://github.com/varadhjain/claude-code-blog-generator" target="_blank">Claude Code Blog Generator</a></p>
      <p style="margin-top: 0.5rem;">AI-powered session analysis • Blog summary generation • Phase detection</p>
    </footer>
  </div>

  <!-- Mermaid.js for diagram rendering -->
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({
      startOnLoad: true,
      theme: 'default',
      themeVariables: {
        fontSize: '14px',
        fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif'
      }
    });
  </script>
</body>
</html>
