{
  "name": "claude-code-blog-generator",
  "version": "0.1.0",
  "description": "Transform Claude Code sessions into engaging, educational blog posts with intelligent narrative chunking and PII redaction",
  "main": "dist/index.js",
  "bin": {
    "blog-post-generator": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "workflow": "npx ts-node scripts/interactive-workflow.ts",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "blog",
    "generator",
    "ai",
    "llm",
    "documentation",
    "narrative",
    "education",
    "tutorial"
  ],
  "author": "Anekanta & Wilhelm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/varadhjain/claude-code-blog-generator.git"
  },
  "bugs": {
    "url": "https://github.com/varadhjain/claude-code-blog-generator/issues"
  },
  "homepage": "https://github.com/varadhjain/claude-code-blog-generator#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "openai": "^4.104.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.13",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
