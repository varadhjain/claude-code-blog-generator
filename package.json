{
  "name": "claude-code-blog-generator",
  "version": "1.0.0",
  "description": "Transform Claude Code sessions into engaging, educational blog posts with intelligent narrative chunking and PII redaction",
  "main": "dist/index.js",
  "bin": {
    "ccblog": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "mkdir -p dist/annotated-viewer/templates/components && mkdir -p dist/blog-summary/templates && cp -r src/annotated-viewer/templates/* dist/annotated-viewer/templates/ && cp -r src/blog-summary/templates/* dist/blog-summary/templates/",
    "build:ccblog": "bun build --compile --outfile ccblog ccblog.ts",
    "build:ccblog:macos": "bun build --compile --target=bun-darwin-arm64 --outfile ccblog-macos-arm64 ccblog.ts",
    "build:ccblog:linux": "bun build --compile --target=bun-linux-x64 --outfile ccblog-linux-x64 ccblog.ts",
    "dev": "tsc --watch",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "annotate": "npx ts-node scripts/user-annotations/annotate-tui.ts",
    "sidebar": "npx ts-node scripts/blog-generation/interactive-sidebar.ts",
    "workflow": "npx ts-node scripts/blog-generation/interactive-workflow.ts",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "blog",
    "generator",
    "ai",
    "llm",
    "documentation",
    "narrative",
    "education",
    "tutorial"
  ],
  "author": "Anekanta & Wilhelm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/varadhjain/claude-code-blog-generator.git"
  },
  "bugs": {
    "url": "https://github.com/varadhjain/claude-code-blog-generator/issues"
  },
  "homepage": "https://github.com/varadhjain/claude-code-blog-generator#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@inquirer/prompts": "^7.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "handlebars": "^4.7.8",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "openai": "^4.104.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/handlebars": "^4.0.40",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.9.2",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
